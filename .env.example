# Sesión mock del portal (obligatorio en producción)
PORTAL_SESSION_SECRET=

# URL de la landing pública (CTA "Acceso a la plataforma" inverso)
NEXT_PUBLIC_LANDING_URL=

# Webhooks Odoo (n8n → crm.lead)
# ODOO_LEAD_WEBHOOK_URL=
# ODOO_LEAD_WEBHOOK_SECRET=
# CONTACT_INQUIRY_WEBHOOK_URL=

# Webhooks Odoo (n8n → crm.lead) (invites, OAuth, reset password). Si entras por IP en LAN, usa esa IP aquí.
# NEXT_PUBLIC_SITE_URL=http://192.168.1.116:3000
# SITE_URL=http://192.168.1.116:3000
# Redirect URLs en Supabase Auth: añade http://<ip>:3000/login/restablecer y /auth/callback

# Supabase Auth (Google OAuth + recuperación de contraseña)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Redirect URLs en Supabase: /auth/callback y /login/restablecer
# Dev: evita invite por correo al crear clientes (rate limit Supabase en plan free)
# PORTAL_SKIP_CLIENT_INVITE_EMAIL=true

# Google Identity Services (botón oficial blanco). Mismo Client ID que en Supabase → Google provider.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Google Identity Services (botón oficial blanco). Mismo Client ID que en Supabase → Google provider.
# PROFILE_CHANGE_WEBHOOK_URL=   # obsoleto: las solicitudes de perfil crean ticket directo en Odoo
# PROFILE_CHANGE_WEBHOOK_SECRET=

# Resend (correo transaccional; dominio verificado en resend.com)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Syntia <onboarding@resend.dev>
# Sin comillas en el valor (evita fallos al enviar)
# Invitaciones cliente: con onboarding@resend.dev solo llegan a tu cuenta Resend
# RESEND_INVITE_OVERRIDE_TO=tu-correo@ejemplo.com

# Odoo (portal: trámites, integraciones, import alta cliente)
# ODOO_URL=https://tu-odoo.ejemplo.com
# ODOO_API_KEY=
# ODOO_TRAMITES_TASK_TAG=
# ODOO_TICKETS_MODEL=helpdesk.ticket
# ODOO_TICKET_CLOSED_FIELD=close_date
# ODOO_TICKET_TEAM_ID=   # helpdesk.team id para consultas creadas desde el portal
# Prefijo del nombre de la tarea raíz en Odoo (p. ej. "Obligaciones Fiscales 2026").
# Los periodos (Trimestre 1, Mensuales, Anuales…) se leen dinámicamente como hijos de esa raíz.
# ODOO_OBLIGACIONES_PARENT_PREFIX=Obligaciones Fiscales
# ODOO_PARTNER_DRIVE_FIELD=x_studio_google_drive
# ODOO_PARTNER_CONTACT_EMAIL_FIELD=x_studio_email_recepcion_nominas
# ODOO_PARTNER_CATALOG_TTL_SECONDS=600
# ODOO_CHATTER_PAGE_SIZE=10
# ODOO_CHATTER_EXCLUDED_PARTNER_IDS=2
# ODOO_CHATTER_FILTER_INTERNAL=true
# Subtipo de comentario en chatter (mail.message.subtype «Discussions»; suele ser 1)
# ODOO_CHATTER_COMMENT_SUBTYPE_ID=1
# ODOO_CHATTER_NOTIFICATIONS_POLL_INTERVAL_MS=60000
# ODOO_CHATTER_NOTIFICATIONS_BATCH_LIMIT=300
# Odoo Sign (firmas pendientes en /firmas)
# ODOO_SIGN_REQUEST_MODEL=sign.request
# ODOO_SIGN_REQUEST_ITEM_MODEL=sign.request.item
# ODOO_SIGN_ITEM_PENDING_STATES=sent,shared
# ODOO_SIGN_REQUEST_ACTIVE_STATES=sent,shared

# Google Drive (service account; carpeta pública dentro del padre de Odoo)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_PUBLIC_SUBFOLDER_NAME=Pública

# Futuro: integraciones portal
# N8N_WEBHOOK_URL=
