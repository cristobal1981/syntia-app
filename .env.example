# Sesión mock del portal (obligatorio en producción)
PORTAL_SESSION_SECRET=

# URL de la landing pública (CTA "Acceso a la plataforma" inverso)
NEXT_PUBLIC_LANDING_URL=

# Webhooks Odoo (n8n → crm.lead)
# ODOO_LEAD_WEBHOOK_URL=
# ODOO_LEAD_WEBHOOK_SECRET=
# CONTACT_INQUIRY_WEBHOOK_URL=

# Solo UI en desarrollo (sin API real)
# NEXT_PUBLIC_FORM_SUBMIT_STUB=true

# Origen permitido para API routes
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SITE_URL=http://localhost:3000

# Dev en LAN: pnpm dev escucha en 0.0.0.0; otros PCs usan http://<tu-ip>:3000
# allowedDevOrigins en next.config.ts incluye 192.168.*.*

# Supabase Auth (Google OAuth + recuperación de contraseña)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Redirect URLs en Supabase: /auth/callback y /login/restablecer

# Google Identity Services (botón oficial blanco). Mismo Client ID que en Supabase → Google provider.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Stub auth: botones de acceso rápido en /login y recuperación de contraseña simulada (preview/local, no producción)
# NEXT_PUBLIC_AUTH_STUB=true

# Solicitud de cambio de perfil (n8n → Odoo helpdesk)
# PROFILE_CHANGE_WEBHOOK_URL=
# PROFILE_CHANGE_WEBHOOK_SECRET=

# Futuro: integraciones portal
# ODOO_URL=
# N8N_WEBHOOK_URL=
